---
import { SITIO } from "../lib/sitio";

const wa = `https://wa.me/${SITIO.whatsapp}?text=${encodeURIComponent("Hola, quiero platicar un proyecto con APS.")}`;
---

<section class="contacto" id="contacto" data-tema="oscuro">
  <div class="contenedor">
    <p class="etiqueta" data-revelar>06 · Contacto</p>

    <h2 class="contacto-titulo titulo" data-dividir>
      Tu imagen habla<br />antes que tú.
    </h2>

    <div class="contacto-rejilla">
      <p class="contacto-texto" data-revelar>
        Cuéntanos qué quieres lograr. Te respondemos con una propuesta clara, tiempos y costo antes de empezar.
      </p>

      <div class="contacto-acciones" data-revelar>
        <a class="contacto-correo titulo" href={`mailto:${SITIO.correo}`} data-magnetico>
          <span>{SITIO.correo}</span>
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
            ><path d="M3 13 13 3M5 3h8v8"></path></svg
          >
        </a>
        <div class="contacto-botones">
          <a class="boton" href={wa} target="_blank" rel="noopener" data-magnetico>
            Escríbenos por WhatsApp
            <svg class="flecha" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
              ><path d="M1 8h13M9 3l5 5-5 5"></path></svg
            >
          </a>
          <a class="boton boton--contorno" href={`tel:${SITIO.telefono.replace(/\s/g, "")}`} data-magnetico>
            {SITIO.telefono}
          </a>
        </div>
      </div>
    </div>

    <ul class="contacto-datos" data-revelar>
      <li>
        <span class="etiqueta">Estudio</span>
        <span>{SITIO.ciudad}</span>
      </li>
      {
        SITIO.redes.map((r) => (
          <li>
            <span class="etiqueta">{r.nombre}</span>
            <a class="enlace" href={r.url} target="_blank" rel="noopener">
              {r.usuario}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .contacto {
    background: var(--grafito);
    color: var(--marfil);
    padding-block: clamp(100px, 18vh, 220px) clamp(60px, 10vh, 120px);
  }
  .contacto > .contenedor > .etiqueta {
    color: var(--dorado);
  }
  .contacto-titulo {
    margin-top: 26px;
    font-size: clamp(44px, 9.6vw, 176px);
    line-height: 0.95;
    letter-spacing: -0.045em;
  }
  .contacto-rejilla {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(28px, 5vw, 90px);
    align-items: end;
    margin-top: clamp(40px, 8vh, 90px);
    padding-top: clamp(28px, 4vh, 44px);
    border-top: 1px solid var(--linea-oscura);
  }
  .contacto-texto {
    max-width: 38ch;
    color: rgb(244 241 234 / 0.72);
    font-size: clamp(16px, 1.25vw, 20px);
  }
  .contacto-acciones {
    display: grid;
    gap: 28px;
    justify-items: start;
  }
  .contacto-correo {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    font-size: clamp(19px, 2.6vw, 44px);
    letter-spacing: -0.03em;
    background: linear-gradient(var(--dorado), var(--dorado)) 0 100% / 0 2px no-repeat;
    transition:
      background-size 0.8s var(--ease-out),
      color 0.4s ease;
    padding-bottom: 6px;
    overflow-wrap: anywhere;
  }
  .contacto-correo:hover {
    background-size: 100% 2px;
    color: var(--dorado);
  }
  .contacto-correo svg {
    width: 0.6em;
    height: 0.6em;
    flex-shrink: 0;
    transition: transform 0.6s var(--ease-out);
  }
  .contacto-correo:hover svg {
    transform: translate(4px, -4px);
  }
  .contacto-botones {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .contacto-datos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    margin-top: clamp(60px, 10vh, 110px);
  }
  .contacto-datos li {
    display: grid;
    gap: 8px;
  }
  .contacto-datos .etiqueta {
    font-size: 10px;
    color: rgb(244 241 234 / 0.5);
  }

  @media (max-width: 820px) {
    .contacto-rejilla,
    .contacto-datos {
      grid-template-columns: 1fr;
    }
  }
</style>
