---
import { ATRIBUTOS } from "../lib/sitio";
---

<section class="manifiesto" id="estudio" data-tema="claro">
  <div class="contenedor">
    <div class="manifiesto-cabeza">
      <p class="etiqueta indice" data-revelar>01 · Estudio</p>
      <p class="manifiesto-lado" data-revelar>
        APS · AranaProStudio une creatividad y tecnología para transformar ideas en experiencias y soluciones reales.
      </p>
    </div>

    <p class="manifiesto-texto titulo" data-palabras>
      APS ayuda a personas y negocios a verse a la altura de lo que valen. Desde la captura de momentos únicos hasta el
      desarrollo de proyectos digitales, conectamos personas, marcas y oportunidades.
    </p>

    <ol class="atributos">
      {
        ATRIBUTOS.map((a, i) => (
          <li class="atributo" data-revelar>
            <span class="atributo-num">0{i + 1}</span>
            <h3 class="titulo">{a.nombre}</h3>
            <p>{a.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .manifiesto {
    position: relative;
    background: var(--marfil);
    color: var(--carbon);
    padding-block: clamp(80px, 14vh, 180px) clamp(90px, 16vh, 200px);
  }
  .manifiesto-cabeza {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
    margin-bottom: clamp(40px, 8vh, 90px);
  }
  .indice {
    color: var(--dorado-oscuro);
  }
  .manifiesto-lado {
    max-width: 34ch;
    color: var(--gris-calido);
  }
  .manifiesto-texto {
    font-size: clamp(28px, 4.4vw, 74px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    max-width: 20ch;
  }
  .manifiesto-texto :global(.palabra) {
    display: inline-block;
    color: rgb(53 59 61 / 0.16);
  }
  :global(html:not(.js-anim)) .manifiesto-texto :global(.palabra) {
    color: inherit;
  }

  .atributos {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(20px, 3vw, 48px);
    margin-top: clamp(70px, 12vh, 140px);
  }
  .atributo {
    position: relative;
    padding-top: 28px;
    border-top: 2px solid var(--carbon);
  }
  .atributo-num {
    position: absolute;
    top: 28px;
    right: 0;
    font-size: 12px;
    font-weight: 600;
    color: var(--dorado-oscuro);
  }
  .atributo h3 {
    font-size: clamp(26px, 2.4vw, 40px);
    margin-bottom: 16px;
  }
  .atributo p {
    color: var(--gris-calido);
    max-width: 32ch;
  }

  @media (max-width: 820px) {
    .manifiesto-cabeza {
      flex-direction: column;
    }
    .atributos {
      grid-template-columns: 1fr;
    }
  }
</style>
