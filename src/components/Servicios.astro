---
import Isotipo from "./Isotipo.astro";
import { SERVICIOS } from "../lib/sitio";
---

<section class="servicios" id="servicios" data-tema="claro">
  <div class="contenedor">
    <div class="servicios-cabeza">
      <div>
        <p class="etiqueta" data-revelar>03 · Servicios</p>
        <h2 class="titulo" data-dividir>Lo que hacemos,<br />bien hecho.</h2>
      </div>
      <div class="filtros" role="group" aria-label="Filtrar servicios" data-filtros>
        <button type="button" aria-pressed="true" data-filtro="todos">Todos</button>
        <button type="button" aria-pressed="false" data-filtro="moments">Moments</button>
        <button type="button" aria-pressed="false" data-filtro="business">Business</button>
      </div>
    </div>

    <ul class="lista" data-servicios>
      {
        SERVICIOS.map((s, i) => (
          <li class="fila" data-linea={s.linea} data-revelar>
            <span class="fila-num">{String(i + 1).padStart(2, "0")}</span>
            <h3 class="fila-titulo titulo">{s.titulo}</h3>
            <p class="fila-detalle">{s.detalle}</p>
            <span class:list={["fila-linea", "etiqueta", `fila-linea--${s.linea}`]}>{s.linea}</span>
          </li>
        ))
      }
    </ul>
  </div>

  <!-- Tarjeta que sigue al cursor (solo escritorio) -->
  <div class="vista" data-vista aria-hidden="true">
    <div class="vista-interior" data-vista-interior>
      <Isotipo />
    </div>
  </div>
</section>

<style>
  .servicios {
    position: relative;
    background: var(--marfil);
    color: var(--carbon);
    padding-block: clamp(90px, 15vh, 180px);
  }
  .servicios-cabeza {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 28px;
    margin-bottom: clamp(40px, 7vh, 80px);
  }
  .servicios-cabeza .etiqueta {
    color: var(--dorado-oscuro);
    margin-bottom: 22px;
  }
  .servicios-cabeza h2 {
    font-size: clamp(34px, 5.6vw, 96px);
    letter-spacing: -0.035em;
  }
  .filtros {
    display: flex;
    gap: 6px;
    padding: 5px;
    border-radius: 999px;
    background: var(--blanco);
  }
  .filtros button {
    padding: 10px 18px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 500;
    transition:
      background 0.4s ease,
      color 0.4s ease;
  }
  .filtros button[aria-pressed="true"] {
    background: var(--carbon);
    color: var(--marfil);
  }

  .lista {
    border-top: 1px solid var(--linea-clara);
  }
  .fila {
    position: relative;
    display: grid;
    grid-template-columns: 60px minmax(0, 1.1fr) minmax(0, 1fr) 110px;
    align-items: center;
    gap: 24px;
    padding-block: clamp(22px, 3.2vh, 36px);
    border-bottom: 1px solid var(--linea-clara);
    isolation: isolate;
    transition:
      opacity 0.5s ease,
      color 0.5s ease;
  }
  /* Relleno diagonal al pasar el cursor */
  .fila::before {
    content: "";
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    z-index: -1;
    background: var(--carbon);
    clip-path: polygon(0 100%, 0 100%, 0 100%, 0 100%);
    transition: clip-path 0.7s var(--ease-out);
  }
  @media (hover: hover) {
    .fila:hover {
      color: var(--marfil);
    }
    .fila:hover::before {
      clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
    }
    .fila:hover .fila-titulo {
      transform: translateX(14px);
    }
  }
  .fila.atenuada {
    opacity: 0.18;
  }
  .fila-num {
    font-size: 13px;
    font-weight: 600;
    color: var(--gris-calido);
    font-variant-numeric: tabular-nums;
  }
  .fila:hover .fila-num {
    color: inherit;
  }
  .fila-titulo {
    font-size: clamp(22px, 2.6vw, 44px);
    letter-spacing: -0.025em;
    transition: transform 0.6s var(--ease-out);
  }
  .fila-detalle {
    color: inherit;
    opacity: 0.72;
    max-width: 42ch;
  }
  .fila-linea {
    justify-self: end;
    font-size: 10px;
    padding: 6px 12px;
    border-radius: 999px;
  }
  .fila-linea--moments {
    color: var(--dorado-oscuro);
    box-shadow: inset 0 0 0 1px var(--dorado);
  }
  .fila-linea--business {
    color: var(--petroleo);
    box-shadow: inset 0 0 0 1px var(--petroleo);
  }
  .fila:hover .fila-linea--moments {
    color: var(--dorado);
  }
  .fila:hover .fila-linea--business {
    color: var(--petroleo-claro);
    box-shadow: inset 0 0 0 1px var(--petroleo-claro);
  }

  .vista {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 260px;
    aspect-ratio: 4 / 5;
    pointer-events: none;
    border-radius: 10px;
    overflow: hidden;
    opacity: 0;
    transform: scale(0.6);
    visibility: hidden;
  }
  .vista-interior {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background: var(--grafito);
    color: var(--dorado);
    transition:
      background 0.5s ease,
      color 0.5s ease;
  }
  .vista-interior[data-linea="business"] {
    background: var(--petroleo);
    color: var(--marfil);
  }
  .vista-interior :global(svg) {
    width: 44%;
    height: auto;
  }

  @media (max-width: 820px) {
    .fila {
      grid-template-columns: 36px 1fr auto;
      gap: 6px 14px;
    }
    .fila-detalle {
      grid-column: 2 / -1;
      grid-row: 2;
      font-size: 15px;
    }
    .vista {
      display: none;
    }
  }
</style>
