---
import Base from "../layouts/Base.astro";
import Preloader from "../components/Preloader.astro";
import Cursor from "../components/Cursor.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import ZoomIsotipo from "../components/ZoomIsotipo.astro";
import Manifiesto from "../components/Manifiesto.astro";
import Marquesina from "../components/Marquesina.astro";
import Lineas from "../components/Lineas.astro";
import Servicios from "../components/Servicios.astro";
import Proceso from "../components/Proceso.astro";
import Trabajo from "../components/Trabajo.astro";
import Contacto from "../components/Contacto.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <Preloader />
  <Cursor />
  <Header />
  <main id="contenido">
    <Hero />
    <ZoomIsotipo />
    <Manifiesto />
    <Marquesina />
    <Lineas />
    <Servicios />
    <Proceso />
    <Trabajo />
    <Contacto />
  </main>
  <Footer />
</Base>

<script>
  import "../scripts/animaciones";
</script>
